{
  "name": "@repo/audit-db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/generated/client/index.js",
  "types": "./src/generated/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/generated/client/index.d.ts",
      "default": "./src/generated/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/generated', 'dist/generated', {recursive: true, force: true})\"",
    "dev": "echo 'audit-db has no dev server'",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "lint": "echo 'No lint configured'",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "prisma": "^6.4.1",
    "typescript": "5.9.3"
  }
}