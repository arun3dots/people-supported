}

// --- Step 5: Consent, Advance Directives & Tracking ---
model ResidentConsent {
  id                    String    @id @default(uuid())
  residentId            String    @unique
  consentSignedBy       String?
  consentRelationship   String?
  consentDate           DateTime?
  confirmGenuine        Boolean   @default(false)
  confirmGdpr           Boolean   @default(false)
  generalConsent        Json?
  consentChecklist      Json?     // Individual agreements checklist with dates & urls
  advanceDirectives     Json?     // Living will, DNR status, Healthcare proxy
  poaDocumentUrl        String?
  guardianshipOrderUrl  String?
  insuranceAssignmentStatus String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  resident              Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

model ResidentBelonging {
  id                String   @id @default(uuid())
  residentId        String
  item              String
  description       String?
  conditionPhotoUrl String?
  estValue          Float?
  storedInSafe      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resident          Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

// --- Pre-admission assessment (Parts A-G), versioned per resident ---
// partB/partE/partF are stored as an encrypted JSON string (see packages/db/src/index.ts).
model ResidentPreAdmission {
  id               String    @id @default(uuid())
  tenantId         String
  branchId         String
  residentId       String
  versionNumber    Int       @default(1)
  parentVersionId  String?
  status           String    @default("Draft") // Draft, Submitted, Accepted, Declined, Superseded
  isCurrent        Boolean   @default(true)
  schemaVersion    Int       @default(1)
  assessedAt       DateTime?
  assessedLocation String?
  assessedById     String?
  assessedByName   String?
  partA            Json?
  partB            Json?
  partC            Json?
  partD            Json?
  partE            Json?
  partF            Json?
  partG            Json?
  roomAllocation   Json?
  managerDecision  Json?
  submittedAt      DateTime?
  submittedById    String?
  createdAt        DateTime  @default(now())
  createdById      String?
  updatedAt        DateTime  @updatedAt
  updatedById      String?

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  branch           Branch    @relation(fields: [branchId], references: [id])
  resident         Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  parentVersion    ResidentPreAdmission?  @relation("PreAdmissionVersions", fields: [parentVersionId], references: [id])
  childVersions    ResidentPreAdmission[] @relation("PreAdmissionVersions")

  @@unique([residentId, versionNumber])
  @@index([tenantId])
  @@index([residentId, isCurrent])
  @@index([status])
}

// --- Care journey step 2: assessment (scored tools + areas of need) ---
// tools: [{ toolKey, name, score, rating, severity, answers, notes }]
// needs: [{ areaKey, area, source, found, level, toolKey, becomesCarePlan }]
model ResidentAssessment {
  id              String    @id @default(uuid())
  tenantId        String
  branchId        String
  residentId      String
  preAdmissionId  String?
  versionNumber   Int       @default(1)
  isCurrent       Boolean   @default(true)
  status          String    @default("Draft") // Draft, Completed
  schemaVersion   Int       @default(1)
  tools           Json?
  needs           Json?
  dols            Json?
  assessedAt      DateTime?
  assessedById    String?
  assessedByName  String?
  completedAt     DateTime?
  completedById   String?
  createdAt       DateTime  @default(now())
  createdById     String?
  updatedAt       DateTime  @updatedAt
  updatedById     String?

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  branch          Branch    @relation(fields: [branchId], references: [id])
  resident        Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  carePlans       ResidentNeedCarePlan[]

  @@unique([residentId, versionNumber])
  @@index([tenantId])
  @@index([residentId, isCurrent])
}

// --- Care journey step 3: one care plan per area of need ---
// areaKey supports standard keys and custom:<uuid> keys from assessment needs.
// content: { source, found, needs, prefs, strengths, outcome, steps[], monitor,
//            escalation, consent, restrictions }
// agreement: { agreedBy[], agreedAt, note }
model ResidentNeedCarePlan {
  id             String    @id @default(uuid())
  tenantId       String
  branchId       String
  residentId     String
  assessmentId   String?
  areaKey        String
  area           String
  supportLevel   String?
  risk           Json?
  content        Json?
  agreement      Json?
  status         String    @default("Draft") // Draft, Agreed, Superseded
  versionNumber  Int       @default(1)
  isCurrent      Boolean   @default(true)
  reviewDate     DateTime?
  agreedAt       DateTime?
  agreedById     String?
  createdAt      DateTime  @default(now())
  createdById    String?
  updatedAt      DateTime  @updatedAt
  updatedById    String?

  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  branch         Branch     @relation(fields: [branchId], references: [id])
  resident       Resident   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  assessment     ResidentAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  tasks          ResidentCareTask[]

  @@unique([residentId, areaKey, versionNumber])
  @@index([tenantId])
  @@index([residentId, isCurrent])
}

// --- Care journey step 4: recurring carer tasks scheduled separately from plan steps ---
// recurrence: { type: 'daily' | 'weekly', days?: number[] (0=Sunday) }
model ResidentCareTask {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String
  residentId   String
  carePlanId   String
  stepIndex    Int? // Retained for existing tasks created from support steps.
  title        String
  description  String?
  shift        String    @default("Day") // Day, Night
  time         String // HH:mm
  role         String    @default("Carer") // Carer, Nurse
  recurrence   Json?
  isActive     Boolean   @default(true)
  startsOn     DateTime? @db.Date
  endsOn       DateTime? @db.Date
  createdAt    DateTime  @default(now())
  createdById  String?
  updatedAt    DateTime  @updatedAt
  updatedById  String?

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  branch       Branch               @relation(fields: [branchId], references: [id])
  resident     Resident             @relation(fields: [residentId], references: [id], onDelete: Cascade)
  carePlan     ResidentNeedCarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  records      ResidentCareTaskRecord[]

  @@index([tenantId])
  @@index([residentId, isActive])
  @@index([carePlanId])
}

model ResidentCareTaskRecord {
  id               String    @id @default(uuid())
  tenantId         String
  residentId       String
  taskId           String
  date             DateTime  @db.Date
  outcome          String // Done, Declined
  note             String?
  recordedAt       DateTime  @default(now())
  recordedById     String?
  recordedByName   String?
  undoneAt         DateTime?
  undoneById       String?

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  resident         Resident         @relation(fields: [residentId], references: [id], onDelete: Cascade)
  task             ResidentCareTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([residentId, date])
  @@index([taskId, date])
}

model ResidentShiftNote {
  id          String   @id @default(uuid())
  tenantId    String
  residentId  String
  date        DateTime @db.Date
  shift       String // Day, Night
  text        String
  authorId    String?
  authorName  String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  resident    Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([residentId, date])
}

model Document {
