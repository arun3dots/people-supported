generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SubscriptionPackage {
  id            String    @id @default(uuid())
  name          String
  priceMonthly  Float
  residentLimit Int
  staffLimit    Int
  featureFlags  Json
  isActive      Boolean   @default(true)
  isCustom      Boolean   @default(false)
  isPublic      Boolean   @default(true)
  currency      String    @default("INR")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  createdById   String?
  deletedAt     DateTime?
  deletedById   String?
  updatedById   String?
  tenants       Tenant[]
  payments      Payment[]
}

model Tenant {
  id                  String               @id @default(uuid())
  name                String
  subdomain           String               @unique
  cqcNumber           String?              @unique
  cqcProviderId       String?
  cqcLocationId       String?
  careHomeType        String?
  registeredProvider  String?
  establishedDate     String?
  website             String?
  status              String               @default("Pending")
  packageId           String?
  trialExpiresAt      DateTime?
  subscriptionStatus      String           @default("unpaid")
  subscriptionActivatedAt DateTime?
  nextRenewalAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  addressLine1        String?
  addressLine2        String?
  city                String?
  postcode            String?
  primaryContactEmail String?
  primaryContactName  String?
  primaryContactPhone String?
  primaryContactRole  String?
  logoUrl             String?
  dpaVersion          String?
  dpaAcceptedAt       DateTime?
  dpaAcceptedByEmail  String?
  privacyNoticeVersion String?
  termsAcceptedAt     DateTime?
  enforceMfaForAllStaff     Boolean          @default(false)
  enablePageViewGeolocation Boolean          @default(false)
  createdById         String?
  deletedAt           DateTime?
  deletedById         String?
  updatedById         String?
  councilPOs          CouncilPO[]
  invoices            Invoice[]
  residents           Resident[]
  roles               Role[]
  shifts              Shift[]
  shiftRequests       ShiftRequest[]
  package             SubscriptionPackage? @relation(fields: [packageId], references: [id])
  branches            Branch[]
  users               User[]
  schemes             Scheme[]
  wings               Wing[]
  carePlans           CarePlan[]
  carePlanGoals       CarePlanGoal[]
  carePlanApprovals   CarePlanApproval[]
  carePlanTasks       CarePlanTask[]
  documents           Document[]
  tenantDocuments     TenantDocument[]
  riskAssessments     RiskAssessment[]
  riskTemplates       RiskTemplate[]
  riskAlerts          RiskAlert[]
  shiftTypes          ShiftType[]
  payments            Payment[]
  departments         Department[]
  expenses            Expense[]
  enquiries           Enquiry[]
  assessmentTemplates AssessmentTemplate[]
  incidents           Incident[]
  staffShiftLogs      StaffShiftLog[]
  bodyMapAssessments  BodyMapAssessment[]
  carePlanReviews     CarePlanReview[]
  mentalCapacityAssessments MentalCapacityAssessment[]
  dolsAuthorizations        DolsAuthorization[]
  dataRightsRequests        DataRightsRequest[]
  clinicalEscalations       ClinicalEscalation[]
  residentPreAdmissions     ResidentPreAdmission[]
  residentAssessments       ResidentAssessment[]
  residentNeedCarePlans     ResidentNeedCarePlan[]
  residentCareTasks         ResidentCareTask[]
  residentCareTaskRecords   ResidentCareTaskRecord[]
  residentShiftNotes        ResidentShiftNote[]
  consentItems              ResidentConsentItem[]
  retentionPolicy           TenantRetentionPolicy?
  controlledDrugEntries     ControlledDrugRegister[]
  medicationStockLedgers    MedicationStockLedger[]
  safeguardingReferrals     SafeguardingReferral[]
  complaints                Complaint[]
  breakGlassAccess          BreakGlassAccess[]
  visitorLogs               VisitorLog[]
  peepRecords               PeepRecord[]
  equipmentMaintenanceLogs  EquipmentMaintenanceLog[]
  staffSupervisions         StaffSupervision[]
  staffAppraisals           StaffAppraisal[]
  auditSchedules            AuditSchedule[]
  cqcNotifications          CqcNotification[]
  leaveRequests             LeaveRequest[]
}

model Branch {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  code            String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  postcode        String?
  status          String    @default("Active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  deletedAt       DateTime?
  deletedById     String?
  updatedById     String?

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  userBranches      UserBranch[]      @relation("UserBranchBranch")
  schemes           Scheme[]
  wings             Wing[]
  residents        Resident[]
  rooms             Room[]
  beds              Bed[]
  incidents         Incident[]
  enquiries         Enquiry[]
  invoices          Invoice[]
  paymentHistories  PaymentHistory[]
  councilPOs        CouncilPO[]
  expenses          Expense[]
  carePlans         CarePlan[]
  carePlanGoals     CarePlanGoal[]
  carePlanApprovals CarePlanApproval[]
  carePlanTasks     CarePlanTask[]
  carePlanReviews   CarePlanReview[]
  mentalCapacityAssessments MentalCapacityAssessment[]
  dolsAuthorizations DolsAuthorization[]
  residentPreAdmissions ResidentPreAdmission[]
  residentAssessments ResidentAssessment[]
  residentNeedCarePlans ResidentNeedCarePlan[]
  residentCareTasks ResidentCareTask[]
  riskAssessments   RiskAssessment[]
  riskAlerts        RiskAlert[]
  documents         Document[]
  shifts            Shift[]
  shiftTypes        ShiftType[]
  shiftRequests     ShiftRequest[]
  staffShiftLogs    StaffShiftLog[]
  departments       Department[]
  clinicalEscalations ClinicalEscalation[]

  @@index([tenantId])
}

//TODO: add mapp tenent to this mapping table to easily find the user count for the tenant
model UserBranch {
  userId    String
  branchId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation("UserBranchBranch", fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model Payment {
  id                String               @id @default(uuid())
  tenantId          String
  packageId         String?
  provider          String
  amount            Float
  currency          String               @default("INR")
  status            String               @default("created")
  isRenewal         Boolean              @default(false)
  failureReason     String?
  providerLinkId    String?
  providerOrderId   String?
  providerPaymentId String?
  shortUrl          String?
  token             String               @unique
  createdAt         DateTime             @default(now())
  paidAt            DateTime?
  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  package           SubscriptionPackage? @relation(fields: [packageId], references: [id])

  @@index([tenantId])
  @@index([providerLinkId])
  @@index([providerPaymentId])
}

model Role {
  id          String    @id @default(uuid())
  tenantId    String?
  name        String
  permissions Json
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  createdById String?
  deletedAt   DateTime?
  deletedById String?
  updatedAt   DateTime  @default(now()) @updatedAt
  updatedById String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  users       User[]
}

model Scheme {
  id                String    @id @default(uuid())
  tenantId          String
  branchId          String
  name              String
  referenceId       String?
  location          String?
  description       String?
  commissioningLa   String?
  schemeManagerId   String?
  commissionedHours Float?
  status            String    @default("Active")
  schemeDetails     Json?
  createdAt         DateTime  @default(now())
  createdById       String?
  deletedAt         DateTime?
  deletedById       String?
  updatedAt         DateTime  @updatedAt
  updatedById       String?
  wings             Wing[]
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  branch            Branch    @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([branchId])
}

model Wing {
  id              String    @id @default(uuid())
  tenantId        String
  branchId        String
  schemeId        String?
  name            String
  code            String?
  description     String?
  primaryContact  String?
  notes           String?
  propertyDetails Json?
  createdAt       DateTime  @default(now())
  createdById String?
  deletedAt   DateTime?
  deletedById String?
  status      String    @default("Active")
  updatedAt   DateTime  @updatedAt
  updatedById String?
  rooms       Room[]
  shifts      Shift[]
  scheme      Scheme?   @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  branch      Branch    @relation(fields: [branchId], references: [id])
  staff       User[]    @relation("StaffWings")

  @@index([tenantId])
  @@index([branchId])
  @@index([schemeId])
}

//TODO add tenentId to room model
model Room {
  id          String    @id @default(uuid())
  wingId      String
  branchId    String
  roomNumber  String
  type        String
  code        String?
  createdAt   DateTime  @default(now())
  createdById String?
  deletedAt   DateTime?
  deletedById String?
  name             String?
  description      String?
  primaryContact   String?
  notes            String?
  status           String    @default("Active")
  updatedAt        DateTime  @updatedAt
  updatedById      String?
  beds             Bed[]
  wing             Wing      @relation(fields: [wingId], references: [id])
  branch           Branch    @relation(fields: [branchId], references: [id])
  staff            User[]    @relation("StaffRooms")

  @@index([branchId])
}

model Bed {
  id                    String    @id @default(uuid())
  roomId                String
  branchId              String
  status                String    @default("Available")
  residentId            String?   @unique
  code                  String?
  createdAt             DateTime  @default(now())
  createdById           String?
  deletedAt             DateTime?
  deletedById           String?
  number                String?
  updatedAt             DateTime  @updatedAt
  updatedById           String?
  bedLabel              String?
  bedType               String?
  bedLength             Int?
  bedWidth              Int?
  safeWorkingLoad       Int?
  heightAdjustment      String?
  sideRails             String?
  pressureMattress      String?
  equipment             String[]
  specificationNotes    String?
  availableFrom         DateTime?
  plannedStatus         String?
  occupancyAvailableFrom String?
  expectedDischargeDate DateTime?
  availabilityNotes     String?
  resident              Resident? @relation(fields: [residentId], references: [id])
  room                  Room      @relation(fields: [roomId], references: [id])
  branch                Branch    @relation(fields: [branchId], references: [id])
  staff                 User[]    @relation("StaffBeds")

  @@index([branchId])
}

model User {
  id                     String                  @id @default(uuid())
  tenantId               String?
  roleId                 String
  email                  String                  @unique
  passwordHash           String
  passwordChangedAt      DateTime?               @default(now())
  fullName               String
  mfaSecret              String?
  dbsNumber              String?
  dbsExpiryDate          DateTime?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  emailVerified          Boolean                 @default(false)
  verificationToken      String?                 @unique
  failedLoginAttempts    Int                     @default(0)
  lockedUntil            DateTime?
  dob                    DateTime?
  niNumber               String?
  createdById            String?
  deletedAt              DateTime?
  deletedById            String?
  updatedById            String?
  mfaEnabled             Boolean                 @default(false)
  mfaResetRequests       MfaResetRequest[]
  refreshTokens          RefreshToken[]
  keyworkerFor           Resident[]              @relation("Keyworker")
  shiftAssignments       ShiftAssignment[]
  staffExpenses          StaffExpense[]
  staffTrainings         StaffTraining[]
  role                   Role                    @relation(fields: [roleId], references: [id])
  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id])
  profile                UserProfile?
  assignedBeds           Bed[]                   @relation("StaffBeds")
  assignedResidents      Resident[]              @relation("StaffResidents")
  assignedRooms          Room[]                  @relation("StaffRooms")
  assignedWings          Wing[]                  @relation("StaffWings")
  careTimelines          CareTimeline[]          @relation("CarerTimeline")
  carePlanApprovals      CarePlanApproval[]      @relation("CarePlanApprovals")
  carePlanReviews        CarePlanReview[]        @relation("CarePlanReviewer")
  capacityAssessments    MentalCapacityAssessment[] @relation("CapacityAssessor")
  assignedCarePlanTasks  CarePlanTask[]          @relation("CarePlanTaskAssignedStaff")
  assignedDailyTasks     DailyTask[]             @relation("DailyTaskAssignedStaff")
  completedTasks         DailyTask[]             @relation("TaskCompleter")
  shiftRequests          ShiftRequest[]
  riskApprovals          RiskAssessment[]        @relation("RiskApprover")
  riskReviews            RiskAssessment[]        @relation("RiskReviewer")
  riskControlAssignments RiskControl[]           @relation("RiskControlAssignee")
  riskControlCompletions RiskControl[]           @relation("RiskControlCompleter")
  riskAlerts             RiskAlert[]             @relation("RiskAlertRecipient")
  rightToWork            RightToWorkCheck?
  dbsCheck               DbsCheck?
  certifications         StaffCertification[]
  healthClearance        HealthClearance?
  immunisations          Immunisation[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  incidentsReported      Incident[]              @relation("IncidentReporter")
  incidentsAssigned      Incident[]              @relation("IncidentAssignee")
  staffShiftLogs         StaffShiftLog[]
  branches               UserBranch[]
  escalationsRaised      ClinicalEscalation[]    @relation("EscalationRaiser")
  escalationsResolved    ClinicalEscalation[]    @relation("EscalationResolver")
  deviceTokens           UserDeviceToken[]
  breakGlassAccess       BreakGlassAccess[]
  staffSupervisions      StaffSupervision[]      @relation("StaffSupervisions")
  supervisorSessions     StaffSupervision[]      @relation("SupervisorSessions")
  staffAppraisals        StaffAppraisal[]        @relation("StaffAppraisals")
  appraiserSessions      StaffAppraisal[]        @relation("AppraiserSessions")
  leaveRequests          LeaveRequest[]
}

model RefreshToken {
  id             String   @id @default(uuid())
  token          String   @unique
  userId         String
  family         String
  isRevoked      Boolean  @default(false)
  activeBranchId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}

model PasswordReset {
  id         String   @id @default(uuid())
  email      String
  otpHash    String
  resetToken String?  @unique
  attempts   Int      @default(0)
  used       Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
}

model MfaResetRequest {
  id        String   @id @default(uuid())
  userId    String
  token     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  profilePhotoUrl String?
  phoneNumber     String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  postcode        String?
  startDate       DateTime?
  department      String?
  qualifications  Json?
  contractType           String?
  contractedHoursPerWeek Float?
  schemeId               String?
  propertyId             String?
  employmentDetails      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  deletedAt       DateTime?
  deletedById     String?
  updatedById     String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffTraining {
  id             String    @id @default(uuid())
  userId         String
  type           String
  expiryDate     DateTime
  certificateUrl String?
  createdAt      DateTime  @default(now())
  createdById    String?
  deletedAt      DateTime?
  deletedById    String?
  updatedAt      DateTime  @updatedAt
  updatedById    String?
  user           User      @relation(fields: [userId], references: [id])
}

model StaffExpense {
  id          String    @id @default(uuid())
  userId      String
  amount      Float
  type        String
  status      String    @default("Pending")
  createdAt   DateTime  @default(now())
  createdById String?
  deletedAt   DateTime?
  deletedById String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  user        User      @relation(fields: [userId], references: [id])
}

model RightToWorkCheck {
  id               String    @id @default(uuid())
  userId           String    @unique
  verificationType String // "Manual", "ShareCode", "IDVT"
  documentType     String? // Passport, Birth Certificate, etc.
  documentNumber   String?
  issueDate        DateTime?
  shareCode        String?
  idvtProvider     String?
  transactionRef   String?
  rtwStatus        String    @default("Pending") // Pending, Verified, Expired, Requires Follow-up
  verificationDate DateTime?
  verifierName     String?
  expiryDate       DateTime?
  followUpDate     DateTime?
  workRestrictions String?
  documentUrl      String? // Link to uploaded scan/PDF
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rtwStatus])
  @@index([expiryDate])
}

model DbsCheck {
  id                String    @id @default(uuid())
  userId            String    @unique
  certificateNumber String?
  type              String // Standard, Enhanced, Enhanced with Barred List
  issueDate         DateTime?
  expiryDate        DateTime? // Recommended renewal date
  updateService     Boolean   @default(false)
  status            String    @default("Pending") // Pending, Clear, Action Required
  documentUrl       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiryDate])
}

model StaffCertification {
  id             String   @id @default(uuid())
  userId         String
  name           String // e.g., Safeguarding, Basic Life Support
  skills         String[] @default([])
  issueDate      DateTime
  expiryDate     DateTime
  status         String // Valid, Expiring Soon, Expired
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiryDate])
}

model HealthClearance {
  id            String    @id @default(uuid())
  userId        String    @unique
  clearanceDate DateTime?
  status        String // Cleared, Pending, Restricted
  notes         String?
  documentUrl   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Immunisation {
  id               String   @id @default(uuid())
  userId           String
  name             String // Hep B, COVID-19, Flu
  dateAdministered DateTime
  status           String // Up to date, Requires Booster
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Resident {
  id                     String              @id @default(uuid())
  tenantId               String
  branchId               String
  fullName               String
  dob                    String
  nhsNumber              String?
  dnarStatus             Boolean             @default(false)
  fundingType            String              @default("Local Authority")
  status                 String              @default("Active")
  keyworkerId            String?
  createdAt              DateTime            @default(now())
  createdById            String?
  deletedAt              DateTime?
  deletedById            String?
  updatedAt              DateTime            @default(now()) @updatedAt
  updatedById            String?
  admissionDate          DateTime            @default(now())
  councilDetails         Json?
  supportedLivingDetails Json?
  doNotAssignIds         String[]
  gpDetails              Json?
  nextOfKin              Json?
  photoUrl               String?
  preferredCarerIds      String[]
  requiredCertifications String[]
  admissionStep          Int                 @default(1)
  isDraft                Boolean             @default(true)
  bodyMapSequence        Int                 @default(0)
  recordState            String              @default("Active") // Active | Archived | Restricted | LegalHold
  recordStateReason      String?
  recordStateUpdatedAt   DateTime?
  recordStateUpdatedById String?

  // Header-banner values mirrored from the current ResidentPreAdmission
  allergySummary         String?
  fallsRiskLevel         String?
  iddsiLevel             String?
  dnacprStatus           String?

  // --- Step sub-tables (1:1 optional, created lazily per wizard step) ---
  profile                ResidentProfile?
  admission              ResidentAdmission?
  careProfile            ResidentCareProfile?
  consent                ResidentConsent?

  // --- Relations ---
  bed                    Bed?
  carePlans              CarePlan[]
  carePlanReviews        CarePlanReview[]
  mentalCapacityAssessments MentalCapacityAssessment[]
  dolsAuthorizations        DolsAuthorization[]
  dataRightsRequests        DataRightsRequest[]
  preAdmissions          ResidentPreAdmission[]
  assessments            ResidentAssessment[]
  needCarePlans          ResidentNeedCarePlan[]
  careTasks              ResidentCareTask[]
  careTaskRecords        ResidentCareTaskRecord[]
  shiftNotes             ResidentShiftNote[]
  careTimelines           CareTimeline[]
  councilPOs             CouncilPO[]
  foodFluidLogs          FoodFluidLog[]
  incidents              Incident[]
  invoices               Invoice[]
  medicationRounds       MedicationRound[]
  medicationPrescriptions MedicationPrescription[]
  observations           Observation[]
  keyworker              User?               @relation("Keyworker", fields: [keyworkerId], references: [id])
  tenant                 Tenant              @relation(fields: [tenantId], references: [id])
  branch                 Branch              @relation(fields: [branchId], references: [id])
  riskAssessments        RiskAssessment[]
  staff                  User[]              @relation("StaffResidents")
  carePlanTasks          CarePlanTask[]
  dailyTasks             DailyTask[]
  documents              Document[]
  belongings             ResidentBelonging[]
  enquiries              Enquiry[]           @relation("EnquiryConvertedResident")
  bodyMapAssessments     BodyMapAssessment[]
  bodyMapFindings        BodyMapFinding[]
  clinicalEscalations    ClinicalEscalation[]
  consentItems           ResidentConsentItem[]
  controlledDrugEntries  ControlledDrugRegister[]
  medicationStockLedgers MedicationStockLedger[]
  safeguardingReferrals  SafeguardingReferral[]
  complaints             Complaint[]
  breakGlassAccess       BreakGlassAccess[]
  visitorLogs            VisitorLog[]
  peepRecord             PeepRecord?
  cqcNotifications       CqcNotification[]

  @@index([tenantId])
  @@index([branchId])
}

// --- Step 1: Residential Identity & Address ---
model ResidentProfile {
  id                     String   @id @default(uuid())
  residentId             String   @unique
  title                  String?
  firstName              String?
  middleName             String?
  lastName               String?
  preferredName          String?
  gender                 String?
  maritalStatus          String?
  preferredCommunication String?
  preferredLanguage      String?
  languagesSpoken        String[]
  interpreterRequired    Boolean  @default(false)
  nationalId             String?  // Encrypted / SSN / Aadhaar / Passport
  nationalIdType         String?
  formerOccupation       String?
  hobbies                String?
  religion               String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  postcode               String?
  country                String?
  insuranceProvider      String?
  niNumber               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  resident               Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

// --- Step 2, 6, 7: Admission, Financial & Room Info ---
model ResidentAdmission {
  id                    String    @id @default(uuid())
  residentId            String    @unique
  admissionType         String?
  admissionSource       String?
  admittedFrom          String?
  referringFacilityName String?
  admissionReason       String?
  referralDate          DateTime?
  expectedAdmissionDate DateTime?
  assignedManagerId     String?
  isSelfFunder          Boolean   @default(false)
  localAuthority        String?
  commissioningContact  Json?
  roomTypePreference    String?
  floorPreference       String?
  specialRequirements   String?
  weeklyFundingAmount   Float?
  topUpAmount           Float?
  payer                 String?
  primaryPaymentMethod  String?
  secondaryCoverage     String?
  insurancePolicyNumber String?
  benefitId             String?
  billingResponsibleParty Json?
  agreedRoomRate        Float?
  agreedRoomRatePeriod  String?   @default("Month")
  depositAmount         Float?
  depositDate           DateTime?
  paymentFrequency      String?
  paymentSchedule       String?
  directDebitDetails    String?
  assignedBedId         String?
  roommateId            String?
  moveInDateTime        DateTime?
  liabilityWaiverSigned Boolean   @default(false)
  assistiveDevices      String[]
  valuablesInSafe       Boolean   @default(false)
  valuablesDescription  String?
  billingCycle          String?
  expectedDischargeDate DateTime?
  stayType              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  resident              Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

// --- Step 3, 4: Care, Medical Details & ADL Assessment ---
model ResidentCareProfile {
  id                    String    @id @default(uuid())
  residentId            String    @unique
  careCategory          String?
  primaryCareNeed       String?
  careComplexity        String?
  primaryDiagnosis      String?
  secondaryDiagnoses    String[]
  heightCm              Float?
  weightKg              Float?
  bmi                   Float?
  baselineVitals        Json?
  allergies             String[]
  medicationAllergies   String[]
  foodAllergies         String[]
  environmentalAllergies String[]
  currentMedications    Json?
  chronicConditions     String[]
  skinConditionPressureAreas String?
  continenceStatus      String?
  continence            String?
  sensoryAids           String[]
  dentalStatus          String?
  substanceUseHistory   String?
  recentHospitalizations String?
  // ADL & Functional Katz Matrix
  adlKatzMatrix         Json?
  adlScore              Int?
  mobility              String?
  mobilityAidsUsed      String[]
  fallRiskScore         String?
  fallsLast6Months      String?
  ambulationDistance    String?
  cognitiveScore        String?
  orientation           String?
  communicationAbility  String?
  behavioralConcerns    String?
  sleepPattern          String?
  dietType              String?
  textureModification   String?
  feedingAssistance     String?
  feedingAssistanceNeed String?
  supportRequired       String[]
  medicalConditions     String[]
  dietaryRequirements   String[]
  sensoryImpairment     String[]
  familyInvolvement     String?
  routinePreferences    String?
  communityNursePhone   String?
  socialWorkerEmail     String?
  mentalHealthTeam      String?
  dentist               String?
  optician              String?
  localAuthorityContact String?
  hospitalConsultant    String?
  hospitalName          String?
  lastHospitalVisitDate DateTime?
  lastGpVisitDate       DateTime?
  postSurgeries         String?
  immunisationStatus    Json?
