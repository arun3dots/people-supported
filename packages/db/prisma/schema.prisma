  hasImpairmentOrDisturbance       Boolean
  impairmentDetails                String
  canUnderstandInfo                Boolean
  canRetainInfo                    Boolean
  canWeighOrUseInfo                Boolean
  canCommunicateDecision           Boolean
  hasCapacity                      Boolean
  bestInterestsRequired            Boolean   @default(false)
