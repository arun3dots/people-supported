  summaryNotes        String
  residentFeedback    String?
  familyFeedback      String?
  domainsEvaluated    String[]  @default([])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  branch              Branch    @relation(fields: [branchId], references: [id])
  carePlan            CarePlan  @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  resident            Resident  @relation(fields: [residentId], references: [id])
  reviewer            User      @relation("CarePlanReviewer", fields: [reviewerId], references: [id])

  @@index([tenantId])
  @@index([branchId])
  @@index([carePlanId])
  @@index([residentId])
  @@index([reviewedAt])
}

model MentalCapacityAssessment {
  id                               String    @id @default(uuid())
  tenantId                         String
  branchId                         String
  residentId                       String
  assessorId                       String
  carePlanId                       String?
  decisionType                     String    // BedRails, SensorMat, CovertMedication, KeypadDoorAccess, FinancialManagement, PersonalCareAssistance, MedicalTreatment, Other
