model BodyMapFinding {
  id               String    @id @default(uuid())
  assessmentId     String
  residentId       String?
  trackingId       String    // "BMF-001", "BMF-002"
  view             String    // "Front" | "Back"
  bodyMapVariant   String    @default("neutral") // "male" | "female" | "neutral"
  anatomyId        String    @default("unspecified") // canonical anatomy ID e.g. "right-index-finger-nail"
  anatomicalRegion String    @default("general") // e.g. "upper_limb"
  bodyPart         String    @default("general") // e.g. "hand"
  subPart          String?   // e.g. "index_finger"
  detail           String?   // e.g. "nail"
  laterality       String?   // "left" | "right" | "midline" | "bilateral"
  locationLabel    String    @default("General") // immutable snapshot e.g. "Right Hand → Index Finger → Nail"
  exactX           Float?    // normalized 0..1 relative to anatomical node
  exactY           Float?    // normalized 0..1 relative to anatomical node
  findingType      String    // Bruise, Skin Tear, Pressure Injury, etc.
  severity         String    // Mild | Moderate | Severe
  pressureUlcerCategory String? // Category 1 | Category 2 | Category 3 | Category 4 | Unstageable | Deep Tissue Injury
  lengthMm         Float?
  widthMm          Float?
  depthMm          Float?
  exudateLevel     String?   // None | Low | Moderate | High
  tissueType       String?   // Epithelialising | Granulating | Sloughy | Necrotic
  dressingApplied  String?
  nextDressingDueAt DateTime?
  description      String?
  onsetDate        DateTime
  status           String    @default("Open") // Open | Resolved
  linkedIncidentId String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNote   String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  resident   Resident?         @relation(fields: [residentId], references: [id])
  assessment BodyMapAssessment @relation(fields: [assessmentId], references: [id])
  photos     BodyMapPhoto[]
  actions    BodyMapFindingAction[]

  @@unique([residentId, trackingId])
  @@index([residentId])
  @@index([assessmentId])
  @@index([linkedIncidentId])
  @@index([anatomyId])
}

model BodyMapFindingAction {
