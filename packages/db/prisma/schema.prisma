  tenantId           String
  branchId           String
  residentId         String
  raisedById         String
  assignedToRole     String       @default("Nurse") // "Nurse", "Manager"
  assignedToId       String?
  reason             String       // AbnormalVitals, RefusedMedication, SkippedTask, AcuteDeterioration, Incident, Fall, Behavioural, Other
  severity           String       @default("Medium") // Low, Medium, High, Critical
  status             String       @default("Open") // Open, Triaged, ActionTaken, EscalatedToGP, EscalatedTo999, EscalatedToManager, Resolved
  initialNotes       String
  sbarSituation      String?
  sbarBackground     String?
  sbarAssessment     String?
  sbarRecommendation String?
  actionsTaken       Json?        // Array<{ role: string, staffName: string, action: string, timestamp: string, notes?: string }>
  vitalsSnapshot     Json?        // { bp, pulse, temp, spo2, resp, news2Score, consciousness }
  taskId             String?
  observationId      String?
  incidentId         String?
  managerNotes       String?
  managerSignedAt    DateTime?
  managerSignedById  String?
  resolvedAt         DateTime?
  resolvedById       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  branch             Branch       @relation(fields: [branchId], references: [id])
  resident           Resident     @relation(fields: [residentId], references: [id])
  raisedBy           User         @relation("EscalationRaiser", fields: [raisedById], references: [id])
  resolvedBy         User?        @relation("EscalationResolver", fields: [resolvedById], references: [id])
  dailyTask          DailyTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  observation        Observation? @relation(fields: [observationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([residentId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

