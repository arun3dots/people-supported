model Incident {
  id               String    @id @default(uuid())
  tenantId         String
  branchId         String
  incidentNumber   String    // Auto-generated: "INC-2026-0001"
  title            String    // E.g. "Fall Un-witnessed"
  category         String    // Fall, Medication, Aggression, Skin Injury, Equipment, Elopement, Pressure Area, Other
  harmLevel        String?   // Level 1–5
  severity         String    @default("Medium") // High, Medium, Low
  status           String    @default("Open")   // Open, Under Review, Closed
  priority         String    @default("Medium") // High, Medium, Low
  incidentDate     DateTime
  incidentTime     String?   // "HH:mm"
  residentId       String?
  roomNumber       String?
  bedNumber        String?
  immediateActions     Json?     // ["First aid provided", "Vitals Recorded"]
  location             String?   // E.g. "Bedroom", "Lounge"
  initialAssessment    String?   // E.g. "Minor skin tear on left elbow"
  investigationDetails Json?     // [{ id, title, subtitle, notes, isSaved }]
  tasks                Json?     // [{ id, title, description, assignedToName, priority, date, time, attachmentCount, notifyEmail }]
  attachments          Json?     // [{ id, name, timestamp, type, previewUrl }]
  complianceItems      Json?     // [{ id, title, timestamp, status }]
  managerNotes         String?   // Management Response Notes
  notes                String?
  reportedById         String?
  assignedToId         String?
  closedAt             DateTime?
  // --- Statutory Duty of Candour (Health and Social Care Act 2008 Reg 20) ---
  dutyOfCandourApplicable     Boolean   @default(false)
  dutyOfCandourStatus         String?   // PendingApology, ApologyGiven, WrittenNoticeSent, Closed
  apologyDate                 DateTime?
  apologyMethod               String?   // InPerson, Phone, VideoCall
  writtenNoticeSentAt         DateTime?
  writtenNoticeDueAt          DateTime? // Statutory 10-day SLA
  // --- CQC Statutory Notification (Registration Reg 18) ---
  cqcNotificationRequired     Boolean   @default(false)
  cqcNotificationSubmittedAt  DateTime?
  cqcReferenceNumber          String?
  createdAt            DateTime  @default(now())
  createdById          String?
  deletedAt            DateTime?
  deletedById          String?
  updatedAt            DateTime  @updatedAt
  updatedById          String?

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  resident   Resident? @relation(fields: [residentId], references: [id])
  reportedBy User?     @relation("IncidentReporter", fields: [reportedById], references: [id])
  assignedTo User?     @relation("IncidentAssignee", fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([branchId])
  @@index([residentId])
  @@index([status])
  @@index([incidentDate])
}

