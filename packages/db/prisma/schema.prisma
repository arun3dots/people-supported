  @@index([tenantId])
  @@index([branchId])
  @@index([recipientId, isRead])
}

model CarePlan {
  id                    String               @id @default(uuid())
  tenantId              String
  branchId              String
  residentId            String
  versionNumber         Int                  @default(1)
  status                String               @default("Draft") // Draft, PendingPrimaryApproval, PendingSecondaryApproval, ChangesRequested, Rejected, Active, Expired, Superseded
  parentVersionId       String?
  renewalReason         String?              // ScheduledReview, ConditionChange, PostIncident, Other
  validFrom             DateTime             @default(now())
  validTo               DateTime?
  nextReviewDate        DateTime?
  description           String?              // Clinical rationale
  authorId              String?
  primaryDoctorId       String?
  secondaryDoctorId     String?
  approvedById          String?
  approvedAt            DateTime?
  secondaryApprovedById String?
  secondaryApprovedAt   DateTime?
  submittedAt           DateTime?
  activatedAt           DateTime?
  expiredAt             DateTime?
  supersededAt          DateTime?
  departments           String[]
  doctorsInvolved            String[]
  authorRole                 String?              @default("SeniorCarer") // SeniorCarer, RegisteredNurse, DeputyManager, RegisteredManager, Other
  clinicalApproverId         String?              // Registered Nurse / Clinical Lead
  managerApproverId          String?              // Registered Manager / Deputy Manager
  residentAgreed             Boolean              @default(true)
  residentAgreementNotes     String?
  representativeName         String?
  representativeRelationship String?
  legalConsentBasis          String?              @default("ResidentSelf") // ResidentSelf, LPA_HealthAndWelfare, CourtOfProtection, BestInterests_Section4
  lastReviewedAt             DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  resident              Resident             @relation(fields: [residentId], references: [id])
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  branch                Branch               @relation(fields: [branchId], references: [id])
  parentVersion         CarePlan?            @relation("CarePlanVersions", fields: [parentVersionId], references: [id])
  childVersions         CarePlan[]           @relation("CarePlanVersions")
  goals                 CarePlanGoal[]
  sections              CarePlanSection[]
  tasks                 CarePlanTask[]
  medications           CarePlanMedication[]
  approvals             CarePlanApproval[]
  reviews               CarePlanReview[]
  capacityAssessments   MentalCapacityAssessment[]

  @@index([residentId])
  @@index([tenantId])
  @@index([branchId])
  @@index([status])
}

model CarePlanReview {
  id                  String    @id @default(uuid())
  tenantId            String
  branchId            String
  carePlanId          String
  residentId          String
  reviewerId          String
  reviewedAt          DateTime  @default(now())
