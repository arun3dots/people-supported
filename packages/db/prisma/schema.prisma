model RiskAssessment {
  id                 String        @id @default(uuid())
  tenantId           String
  branchId           String
  residentId         String
  templateId         String?
  category           String
  title              String
  hazardDescription  String
  tool               String?
  likelihood         Int
  severity           Int
  inherentScore      Int
  inherentLevel      String
  residualLikelihood Int?
  residualSeverity   Int?
  residualScore      Int?
  residualLevel      String?
  status             String        @default("Draft")
  reviewFrequency    String        @default("Quarterly")
  nextReviewDate     DateTime
  factors            Json?
  reviewedById       String?
  reviewedAt         DateTime?
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime      @default(now())
  createdById        String?
  deletedAt          DateTime?
  deletedById        String?
  updatedAt          DateTime      @updatedAt
  updatedById        String?
  resident           Resident      @relation(fields: [residentId], references: [id])
