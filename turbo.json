{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "KMS_TEST_DATABASE_URL",
    "ENCRYPTION_KEY",
    "ENCRYPTION_KEY_PREVIOUS",
    "ENCRYPTION_KEY_LEGACY",
    "AWS_REGION",
    "AWS_KMS_DATA_KEY_ID",
    "AWS_KMS_S3_KEY_ID",
    "AWS_CONFIG_FILE",
    "AWS_SHARED_CREDENTIALS_FILE",
    "AWS_EC2_METADATA_DISABLED",
    "AWS_EC2_METADATA_SERVICE_ENDPOINT",
    "KMS_FIELD_WRITES_ENABLED",
    "AUDIT_SIGNING_KEY",
    "AUDIT_SIGNING_KEY_LEGACY",
    "STRICT_SECRET_CHECK",
    "JWT_SECRET",
    "COGNITO_AUTH_ENABLED",
    "COGNITO_REGION",
    "COGNITO_APP_PUBLIC_KEY_B64",
    "COGNITO_SUPERADMIN_AUTH_ENABLED",
    "COGNITO_SUPERADMIN_CALLBACK_URL",
    "COGNITO_SUPERADMIN_SIGN_OUT_URL",
    "COGNITO_SUPERADMIN_CLIENT_ID",
    "COGNITO_SUPERADMIN_CLIENT_SECRET",
    "COGNITO_REQUIRE_AMR_MFA",
    "COGNITO_REQUIRED_ACR_VALUES",
    "LEGACY_AUTH_ENABLED",
    "INTERNAL_API_URL",
    "LEGACY_COOKIE_DOMAIN",
    "COOKIE_HOST_ONLY",
    "NEXT_DIST_DIR",
    "SKIP_DOTENV",
    "PLATFORM_ADMIN_EMAILS",
    "PLATFORM_ADMIN_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["COGNITO_*"]
    }
  }
}
